{
  "manifest_version": 3,
  "name": "Code Connect",
  "version": "0.0.1",
  "description": "Bridges competitive programming judges to the Code Connect VS Code extension.",
  "permissions": ["offscreen", "storage"],
  "host_permissions": [
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/problemset/problem/*/*",
        "*://codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/problemset/problem/*/*",
        "*://*.codeforces.com/contest/*/problem/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
